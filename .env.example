# Copy to .env.local (local) and Hostinger → Environment Variables (production)
# Values may be any playable URL: MP4, Vimeo, Bunny.net, Cloudflare Stream, etc.
# WordPress ACF fields `vimeo_url_desktop` / `vimeo_url_mobile` override these per category/post.

NEXT_PUBLIC_WORDPRESS_API=https://tokiotours.jp/blog/wp-json/wp/v2

NEXT_PUBLIC_VIMEO_HERO_DESKTOP=https://cdn.coverr.co/videos/coverr-aerial-view-of-a-tropical-beach-5635/1080p.mp4
NEXT_PUBLIC_VIMEO_HERO_MOBILE=https://cdn.coverr.co/videos/coverr-walking-on-the-beach-1583/1080p.mp4

NEXT_PUBLIC_VIMEO_ASIA_DESKTOP=https://cdn.coverr.co/videos/coverr-drone-shot-over-rice-terraces-5633/1080p.mp4
NEXT_PUBLIC_VIMEO_ASIA_MOBILE=https://cdn.coverr.co/videos/coverr-asian-temple-in-the-mountains-9722/1080p.mp4

NEXT_PUBLIC_VIMEO_EUROPE_DESKTOP=https://cdn.coverr.co/videos/coverr-santorini-at-sunset-1663/1080p.mp4
NEXT_PUBLIC_VIMEO_EUROPE_MOBILE=https://cdn.coverr.co/videos/coverr-narrow-european-street-9724/1080p.mp4
