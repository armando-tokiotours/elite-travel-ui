# Copy to .env.local (local) and Hostinger → Environment Variables (production)
# WordPress ACF fields `vimeo_url_desktop` / `vimeo_url_mobile` override these per category/post.

# SITE DOMAIN CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://travelexperiencesgroup.com
NEXT_PUBLIC_WORDPRESS_URL=https://travelexperiencesgroup.com/blog
NEXT_PUBLIC_WORDPRESS_API_URL=https://travelexperiencesgroup.com/blog/wp-json/wp/v2

# BRAND PORTAL DOMAINS
NEXT_PUBLIC_TOKIOTOURS_URL=https://tokiotours.com
NEXT_PUBLIC_ELITE_TRAVEL_URL=https://elitetravelexp.com

# Desktop Videos (16:9 - ID: 1221118238)
NEXT_PUBLIC_VIMEO_HERO_DESKTOP=https://vimeo.com/1221118238
