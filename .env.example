# Copy to .env.local (local) and Hostinger → Environment Variables (production)
# WordPress ACF fields `vimeo_url_desktop` / `vimeo_url_mobile` override these per category/post.

NEXT_PUBLIC_WORDPRESS_API=https://tokiotours.jp/blog/wp-json/wp/v2

# Desktop Videos (16:9 - ID: 1221118238)
NEXT_PUBLIC_VIMEO_HERO_DESKTOP=https://vimeo.com/1221118238
NEXT_PUBLIC_VIMEO_ASIA_DESKTOP=https://vimeo.com/1221118238
NEXT_PUBLIC_VIMEO_EUROPE_DESKTOP=https://vimeo.com/1221118238
NEXT_PUBLIC_VIMEO_COUNTRY_DESKTOP=https://vimeo.com/1221118238

# Mobile Videos (9:16 - ID: 1221118464)
NEXT_PUBLIC_VIMEO_HERO_MOBILE=https://vimeo.com/1221118464
NEXT_PUBLIC_VIMEO_ASIA_MOBILE=https://vimeo.com/1221118464
